{
  "name": "ai-orb",
  "version": "3.0.1",
  "description": "A tiny SVG orb that shows what your AI assistant is doing — thinking, working, waiting on you, done. Zero dependencies.",
  "keywords": [
    "ai",
    "assistant",
    "chatbot",
    "avatar",
    "svg",
    "loading",
    "status",
    "indicator",
    "vue",
    "zero-dependency"
  ],
  "license": "MIT",
  "author": "webkubor",
  "homepage": "https://github.com/webkubor/ai-orb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webkubor/ai-orb.git"
  },
  "bugs": {
    "url": "https://github.com/webkubor/ai-orb/issues"
  },
  "type": "module",
  "sideEffects": [
    "./src/creatures.js"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./vue": {
      "types": "./types/vue.d.ts",
      "default": "./src/vue.js"
    },
    "./package.json": "./package.json",
    "./creatures": {
      "types": "./types/creatures.d.ts",
      "default": "./src/creatures.js"
    },
    "./widget": {
      "types": "./types/widget.d.ts",
      "default": "./src/widget.js"
    }
  },
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "files": [
    "src",
    "types",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "README.widget.md"
  ],
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "demo": "node -e \"console.log('打开 demo/index.html 即可，零构建。')\""
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@vue/server-renderer": "^3.5.41",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.64.1",
    "vue": "^3.5.41"
  }
}
